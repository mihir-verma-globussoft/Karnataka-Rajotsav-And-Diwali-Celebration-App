<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the festival poster (the same artwork as the login and
     countdown screens, assets/auth/login_bg.jpg) on the app's night colour.
     launch_bg.jpg is that poster centre-cropped to a modern phone's shape
     (about 9:19.5), because a window background cannot "cover" an image. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_night" />
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launch_bg" />
    </item>
</layer-list>
